# Application
PORT=8080

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=dp-vc-webApp

# Redis
REDIS_URI=localhost:6379
REDIS_PASSWORD=
REDIS_PREFIX=dp-vc-webApp

# Payment notifications
PAYMENT_REMINDER_DAYS=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=

# Authentication
AUTH_SECRET=change-this-secret-in-production
AUTH_TOKEN_HOURS=24

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=dp-vc-webApp

# Environment
APP_ENV=development
